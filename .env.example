# Feishu / Lark
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_CALENDAR_TARGET=app
FEISHU_CALENDAR_ID=

# OpenClaw server (leave empty to fall back to Ollama)
OPENCLAW_URL=

# Local LLM via Ollama
MODEL_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

# OpenAI-compatible cloud model alternative.
# Set MODEL_PROVIDER=openai and fill these when Ollama is unavailable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_EMBED_MODEL=
# OpenAI-compatible providers that support thinking mode can be sped up for demo.
# true/false. Demo scripts inject this into /chat/completions requests only at runtime.
# main.py 也会读取此值，与 demo 行为一致；留空则不注入字段（保留服务端默认）。
LLM_ENABLE_THINKING=false

# 跳过 Graphiti 卡片写入（card_generator._write_card_to_graphiti 替换为 no-op）。
# Demo 默认跳过；main.py 设为 true 才跳过。生产链路通常保持空/false 以保留 Graphiti 索引。
SKIP_GRAPHITI_CARD_WRITE=false

# 完全禁用 Graphiti（不连 Neo4j、不建索引、不写卡片、不写 evidence、不做图搜索）。
# 设为 true 时隐含 SKIP_GRAPHITI_CARD_WRITE=true。当前阶段未用到 graphiti 召回时建议开启。
DISABLE_GRAPHITI=false

# 两段式检索：hybrid 召回 K 张 → LLM rerank 选 top-N。
# 关闭时 retriever.retrieve 仍走 hybrid 单段（embedding cosine + 分层 bigram）。
# 打开后单次查询多 1 次 LLM 调用（~1-2s），用 LLM_SEED 复用确定性参数。
RERANK_ENABLED=false
RERANK_RECALL_K=10

# Optional LLM guard for realtime schedule/task cards.
# When true, rules still do cheap first-pass detection, then an LLM confirms
# only schedule/task candidates. This reduces false positive cards, including
# @bot execution intents such as "帮我约明天下午3点评审会".
REALTIME_LLM_ACTION_CLASSIFIER=false

# DeepSeek（LLM only，Embedding 回退到本地 Ollama）
# 填写后 Graphiti 实体抽取走 DeepSeek，向量化仍走 OLLAMA_URL + EMBED_MODEL
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Batch write side
# Default is 60 seconds for current P0 debugging and validation.
BATCH_POLL_INTERVAL=60
# P0 default: keep EvidenceBlock in local store and avoid Graphiti edge-extraction instability.
INDEX_EVIDENCE_IN_GRAPHITI=false

# P1-6 Event segmentation strategy
# time     (default) P0 time-gap + message-count thresholds, no external deps
# semantic           Embedding cosine-similarity segmentation; falls back to time on failure
# llm                LLM topic-aware segmentation; falls back to semantic, then time on failure
SEGMENTER_STRATEGY=time
# Time gap (seconds) between adjacent messages that forces a new block (both strategies)
# Default 300s. Lower to 90 or 60 when messages are sent in rapid test sessions.
BLOCK_GAP_SECONDS=300
# Hard cap on messages per block (both strategies)
MAX_BLOCK_MESSAGES=30
# Cosine similarity below this value triggers a semantic block boundary (semantic mode only)
# 0.50 works better for different topics within the same project context
SEMANTIC_THRESHOLD=0.50
# Minimum messages in current block before a semantic cut is allowed
MIN_BLOCK_MESSAGES=3

# Feishu demo playback
# Target real Feishu group chat for demo playback and backend memory writes.
# If omitted, demo/play_feishu_demo.py falls back to the fixture chat_id.
DEMO_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional custom bot webhooks for multi-role front-end playback.
# Each webhook should belong to a custom bot installed in the same DEMO_CHAT_ID group.
# These webhooks only send display messages; backend memory is fed from the fixture directly.
DEMO_WEBHOOK_PM=
DEMO_WEBHOOK_DEV=
DEMO_WEBHOOK_HR=
DEMO_WEBHOOK_ALGO=
DEMO_WEBHOOK_DESIGN=
DEMO_WEBHOOK_QA=
DEMO_WEBHOOK_OPS=

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Neo4j (for Graphiti)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
