{
  "schema_version": "dual_channel_benchmark_v2",
  "case_id": "full_demo_v2_productionish_pack_001",
  "description": "独立 benchmark v2 多群聊专项覆盖集：核心产品/研发群、发布运营群、会务组织群与压力测试群分离，覆盖干扰噪声、日程待办、半截话题、refine、supersede、矛盾更新、source/version/topic 查询、多主题并行与稀疏窗口补上下文。",
  "chat_id": "oc_proj_core",
  "replay_policy": {
    "mode": "dual_channel_batch_replay",
    "description": "每个 batch 内消息先逐条进入实时层，再将整批消息交给写入层。",
    "write_layer_should_ignore": [
      "@机器人查询消息",
      "普通历史提问",
      "日程/待办触发消息",
      "interactive 噪声卡片",
      "机器人回复",
      "系统通知"
    ],
    "partial_topic_policy": "半截话题允许生成 Progress，也允许暂不落正式卡片；后续批次可通过 refine 或 supersede 更新。"
  },
  "coverage_targets": {
    "realtime": [
      "query",
      "topic_list",
      "schedule",
      "task",
      "noop"
    ],
    "write_side": [
      "anti_noise",
      "progress",
      "refine_candidate",
      "supersede_candidate",
      "conflict_candidate",
      "multi_topic_batch",
      "sparse_window_context"
    ],
    "query_followups": [
      "source",
      "version",
      "summary",
      "topic_list"
    ]
  },
  "answer_policy": {
    "expected_brief_field": "expected_brief",
    "brief_use": "供人工/模型相似度评测的单句标准答案",
    "structured_use": "expected / expected_write_result 供动作级和关系级自动校验",
    "format_expectation": "每个 batch 同时保留结构化预期和一句话预期，兼顾格式与标准答案"
  },
  "evaluation_axes": {
    "cluster_generation_and_update": true,
    "long_term_recall": true,
    "format_adherence": true,
    "standard_answer_available": true,
    "multi_line_parallel_classification": true,
    "anti_interference": true,
    "refine_and_supersede": true,
    "topic_summary_listing": true
  },
